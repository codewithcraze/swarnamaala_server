# Same MongoDB database the main site uses.
MONGODB_URI=mongodb://127.0.0.1:27017/swarnamaala

# Secret for signing admin CRM tokens (must be different from the site JWT).
CRM_JWT_SECRET=change-this-to-a-long-random-crm-secret

# Admin login credentials for the CRM.
ADMIN_EMAIL=admin@swarnamaala.in
ADMIN_PASSWORD=admin12345

# Port the CRM API listens on.
PORT=5001

# Origin of the CRM frontend (for CORS).
CRM_FRONTEND_ORIGIN=http://localhost:5173

# S3 (same bucket as the main site) for blog image uploads.
ACCESSKEY=your-access-key
SECRETKEY=your-secret-key
REGION=us-east-1
BUCKETNAME=your-bucket

# Main site base URL, used to build proxied image URLs (/api/images/...).
SITE_URL=http://localhost:3000
